{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/we-promise/sure-cli/docs/schemas/v1/analyze_leaks.schema.json",
  "title": "sure-cli analyze leaks v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dates are inclusive; days counts both ends.",
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"},
        "days": {"type": "integer", "minimum": 1}
      },
      "required": ["start", "end", "days"]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "description": "Amounts are major units of each candidate's currency.",
      "properties": {
        "min_count": {"type": "integer"},
        "min_total": {"type": "number"},
        "max_avg": {"type": "number"},
        "currency": {"type": "string"}
      },
      "required": ["min_count", "min_total", "max_avg"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "merchant_id": {"type": "string"},
          "grouped_by": {"enum": ["merchant", "name"]},
          "currency": {"type": "string"},
          "count": {"type": "integer"},
          "total_amount": {"type": "number"},
          "avg_amount": {"type": "number"},
          "spike_amount": {"type": "number"},
          "sample_tx_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"},
          "suggested_action": {"type": "string"}
        },
        "required": ["name", "grouped_by", "currency", "count", "total_amount", "confidence"]
      }
    }
  },
  "required": ["window", "params", "candidates"]
}
